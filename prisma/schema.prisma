generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id            String        @id @default(uuid())
  name          String        @db.VarChar(100)
  accountNumber String?       @db.VarChar(50)
  apiKey        String        @unique @db.VarChar(64)
  secretKey     String        @db.VarChar(128)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]

  @@map("merchants")
}

model Transaction {
  id                String            @id @default(uuid())
  aliasRef          String            @unique
  merchantId        String?
  merchant          Merchant?         @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  amount            Decimal           @db.Decimal(10, 2)
  currency          String            @default("BOB")
  gloss             String?           @db.VarChar(255)
  status            TransactionStatus @default(PENDING)
  qrData            String            @db.Text
  callbackUrl       String?           @db.VarChar(500)
  payerName         String?           @db.VarChar(100)
  payerAccount      String?           @db.VarChar(50)
  receiptNumber     String?           @db.VarChar(50)
  expiresAt         DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  webhookDeliveries WebhookDelivery[]

  @@map("transactions")
}

model WebhookDelivery {
  id            String         @id @default(uuid())
  transactionId String
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  url           String         @db.VarChar(500)
  payload       Json
  attempt       Int            @default(1)
  maxAttempts   Int            @default(4)
  statusCode    Int?
  responseBody  String?        @db.Text
  status        DeliveryStatus @default(PENDING)
  nextRetryAt   DateTime?
  lastError     String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("webhook_deliveries")
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}